@page "/"
@inject HttpClient Http
@inject ISnackbar Snackbar
@using TeamManager.UI.Helpers
@using TeamManager.UI.Models

<PageTitle>Registro</PageTitle>

<MudText Typo="Typo.h3" GutterBottom="true">Control de Asistencia</MudText>
<MudTabs Elevation="3" Rounded="true" ApplyEffectsToContainer="true" TabPanelsClass="pa-3" Color="Color.Dark">
    <MudTabPanel Text="Registrar Evento">
        @* <MudText Class="mb-8">Seleccione la información requerida para registrar el evento</MudText> *@
        <MudStack Row Class="justify-space-between mud-width-full">

            <MudSelect T="Activity" @bind-Value="_selectedActivity" Variant="Variant.Outlined" Label="Tipo de actividad">
                @foreach (var act in Enum.GetValues(typeof(Activity)).Cast<Activity>())
                {
                    <MudSelectItem Value="act">@ActivityTranslator.TranslateActivity(act)</MudSelectItem>
                }
            </MudSelect>
            <MudDatePicker @bind-Date="_selectedDate" Label="Fecha del evento" Variant="Variant.Outlined" />
        </MudStack>
        <MudStack Row Class="justify-space-between mud-width-full">
            <MudTextField T="string"
                          Label="Observaciones"
                          Variant="Variant.Outlined"
                          Lines="3"
                          MaxLines="6"
                          Sizing="InputSizing.Auto"
                          Placeholder="" />
        </MudStack>

       
        <MudStack Justify="Justify.Center">
                <MudTable T="Player" Items="@players" Hover="true" SortLabel="Sort By" Elevation="3" AllowUnsorted="false" Dense="true" Bordered="true" FixedHeader="true" Height=""
                     EditTrigger="TableEditTrigger.RowClick" RowEditPreview="BackUpRow" RowEditCommit="CommitRowChanges">
                    <HeaderContent> 
                        <MudTd Style="width: 50px;">
                            <MudCheckBox T="bool"
                                    Value="@AllChecked"
                                    ValueChanged="OnSelectAllChanged" />
                        </MudTd>
                        <MudTh><MudTableSortLabel SortBy="new Func<Player, object>(p => p.FullName)">Nombre</MudTableSortLabel></MudTh>
                        <MudTh>Asistencia</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd>
                            <MudCheckBox T="bool"
                                    Value="@_selectedPlayers.Any(x => x.PlayerId == context.PlayerId)"
                                    ValueChanged="@(isChecked => OnCheckRowChanged(context, isChecked))" />
                        </MudTd>

                        <MudTd DataLabel="Nombre">@context.FullName</MudTd>
                        <!--<MudTd DataLabel="Asistencia">@context.Assistance.GetDisplayName()</MudTd>-->
                        <MudTd DataLabel="Asistencia">
                        @if (context.Assistance != @AttendanceStatus.AbsentUnjustified && context.Assistance != @AttendanceStatus.Present)
                        {
                            <MudText T="string">@context.Assistance.GetDisplayName()</MudText>
                        }
                        else if (_selectedPlayers.Contains(context))
                        {
                            <MudText T="string">@AttendanceStatus.Present.GetDisplayName()</MudText>
                        }
                        else
                        {
                            <MudText T="string">@AttendanceStatus.AbsentUnjustified.GetDisplayName()</MudText>
                        }
                        </MudTd>
                    </RowTemplate>
                 <RowEditingTemplate>
                    <MudTd>
                        <MudCheckBox T="bool"
                            Value="@_selectedPlayers.Any(x => x.PlayerId == context.PlayerId)"
                            ReadOnly= "true" />
                    </MudTd>
                    <MudTd DataLabel="Nombre">@context.FullName </MudTd>
                    <MudTd DataLabel="Asistencia">
                        <MudSelect T="AttendanceStatus" @bind-Value="context.Assistance" Dense="true">
                            @foreach (var status in Enum.GetValues<AttendanceStatus>())
                            {
                                <MudSelectItem Value="@status">@status.GetDisplayName()</MudSelectItem>
                            }
                        </MudSelect>
                    </MudTd>
                </RowEditingTemplate> 
                    <PagerContent>
                        <MudTablePager PageSizeOptions="new int[] { 50, 100 }" />
                    </PagerContent>
                </MudTable>
            
            <!--<MudText>Seleccionado (@_selectedPlayers?.Count): @(_selectedPlayers == null ? "" : string.Join(", ", _selectedPlayers.OrderBy(x => x.FirstName).Select(x => x.FirstName)))</MudText> -->
            <MudText>Seleccionado (@(players?.Count(x => x.Assistance == AttendanceStatus.Present || x.Assistance == AttendanceStatus.PresentNoPractice))): 
                @(string.Join(", ", players
                .Where(x => x.Assistance == AttendanceStatus.Present || x.Assistance == AttendanceStatus.PresentNoPractice)
                .OrderBy(x => x.FirstName)
                .Select(x => x.FirstName))) 
            </MudText>
        </MudStack>

        <MudStack Justify="Justify.FlexEnd" AlignItems="AlignItems.End">
            <MudTooltip Text="Guardar el registro de asistencia" Placement="Placement.Right">
                <MudFab Color="Color.Tertiary" StartIcon="@Icons.Material.Filled.Save" OnClick="SaveData" />
            </MudTooltip>
        </MudStack>
    </MudTabPanel>
    <MudTabPanel Text="Historial de Eventos">
        <MudText Class="mb-8">Aquí se mostrarán los eventos registrados</MudText>
        <!-- Aquí puedes agregar una tabla o lista para mostrar el historial de eventos -->
    </MudTabPanel>
</MudTabs>

@code {
    private Activity _selectedActivity;
    private DateTime? _selectedDate = DateTime.Today;
    private Player? playerBeforeEdit;
    private List<Player> players = new();
    private List<Player> _selectedPlayers = new();
    private bool AllChecked => players.Count > 0 && _selectedPlayers.Count == players.Count;

    private void OnSelectAllChanged(bool isAllChecked)
    {
        _selectedPlayers.Clear();
        if (isAllChecked)
        {
            foreach (var player in players)
            {
                player.Assistance = AttendanceStatus.Present;
                _selectedPlayers.Add(player);
            }
        }
        else
        {
            foreach (var player in players)
            {
                player.Assistance = AttendanceStatus.AbsentUnjustified;
            }
        }
    }

    private void OnCheckRowChanged(Player player, bool isChecked)
    {
        var exists = _selectedPlayers.FirstOrDefault(p => p.PlayerId == player.PlayerId);
        if (isChecked)
        {
            if (player.Assistance != AttendanceStatus.Present || player.Assistance != AttendanceStatus.PresentNoPractice)
                player.Assistance = AttendanceStatus.Present;
            if (exists!=null) // just playing safe by removing the existing player
            {
                _selectedPlayers.RemoveAll(p => p.PlayerId == player.PlayerId);
            }
            _selectedPlayers.Add(player);
        }
        else
        {
            player.Assistance = AttendanceStatus.AbsentUnjustified;
            _selectedPlayers.RemoveAll(p => p.PlayerId == player.PlayerId);
        }
    }

    private void BackUpRow(object element)
    {
        var selectedPlayer = element as Player;
        playerBeforeEdit = selectedPlayer; //with { Assistance = selectedPlayer.Assistance };
    }

    private void CommitRowChanges(object element)
    {
        var player = element as Player;
        _selectedPlayers.RemoveAll(p => p.PlayerId == player.PlayerId);

        if (player.Assistance == AttendanceStatus.Present || player.Assistance == AttendanceStatus.PresentNoPractice)
        {
           _selectedPlayers.Add(player);
        }
    }

    protected override async Task OnInitializedAsync()
    {
        players = await Http.GetFromJsonAsync<List<Player>>("sample-data/players.json");
    }

    protected void EditPlayer(Player player)
    {
        Snackbar.Configuration.PositionClass = Defaults.Classes.Position.TopEnd;
        Snackbar.Add($"Editar jugador: {player.FullName}", Severity.Info);
    }

    private void SaveData()
    {
        // Aquí simulas el guardado en BD
        // ...

        // Mostrar alerta
        foreach (var player in players)
        {
            if (_selectedPlayers.Contains(player))
            {
                player.Assistance = AttendanceStatus.Present;
            }
        }
        Snackbar.Configuration.PositionClass = Defaults.Classes.Position.TopEnd;
        Snackbar.Add("Registro de evento satisfactorio", Severity.Success);
    }


}